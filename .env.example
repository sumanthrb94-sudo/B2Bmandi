# --- Database (Supabase project: mandi-db / ref fvwfodmxmesimnknpujg, ap-northeast-1) ---
# DATABASE_URL must be a POOLED connection (Supavisor transaction pooler, port
# 6543, with ?pgbouncer=true). DIRECT_URL is the session pooler (port 5432) used
# for migrations / `prisma db push`. Replace [YOUR-DB-PASSWORD] with the project's
# database password, URL-encoded (e.g. an `@` becomes `%40`).
DATABASE_URL="postgresql://postgres.fvwfodmxmesimnknpujg:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.fvwfodmxmesimnknpujg:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- Auth ---
# REQUIRED in production (the app fails closed and throws if it is missing).
# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET="generate-a-long-random-string"

# --- Phone OTP onboarding ---
# No SMS provider is wired up yet, so by default the generated 6-digit code is
# returned to the client (and shown in the UI) to keep the signup flow usable.
# Once you integrate a real SMS sender in app/api/auth/otp/start, set this to
# "false" so codes are delivered over SMS instead of exposed in the response.
OTP_DEV_MODE="true"

# --- Seeding ---
# Enables the /api/seed endpoint. Set to a secret value and pass it when
# triggering a seed; leave unset to keep seeding disabled.
SEED_SECRET="generate-a-seed-secret"

# --- Site ---
# Public base URL of the deployed app. Used by the sitemap / canonical URLs.
# e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Razorpay (server) ---
# Razorpay API credentials (use TEST keys in non-production environments).
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# --- Razorpay (client) ---
# Exposed to the browser for the checkout widget. Same value as the test key id.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
