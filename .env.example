# --- Database ---
# Local dev: a single direct connection is fine.
# Production (serverless on Vercel): DATABASE_URL must be a POOLED connection
# (e.g. Supabase port 6543 with ?pgbouncer=true), and DIRECT_URL the direct
# connection (port 5432) used for migrations / `prisma db push`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth ---
# Long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET="generate-a-long-random-string"
