    {
      "name": "Catalog",
      "item": [
        {
          "name": "GET /api/products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('products is a non-empty array', function () {",
                  "  pm.expect(json.products).to.be.an('array');",
                  "  pm.expect(json.products.length).to.be.above(0);",
                  "});",
                  "var p0 = json.products[0];",
                  "pm.test('first product has expected shape', function () {",
                  "  pm.expect(p0).to.have.property('id');",
                  "  pm.expect(p0).to.have.property('slug');",
                  "  pm.expect(p0).to.have.property('name');",
                  "  pm.expect(p0).to.have.property('pricePerUnit');",
                  "  pm.expect(p0).to.have.property('minOrderQty');",
                  "  pm.expect(p0).to.have.property('unit');",
                  "  pm.expect(p0).to.have.property('stockQty');",
                  "});",
                  "pm.collectionVariables.set('productId', p0.id);",
                  "pm.collectionVariables.set('slug', p0.slug);",
                  "",
                  "// Pick a product whose minOrderQty <= 20 and with enough stock to order.",
                  "var orderable = json.products.find(function (p) {",
                  "  return p.minOrderQty <= 20 && p.stockQty >= p.minOrderQty;",
                  "});",
                  "pm.test('an orderable product (minOrderQty <= 20) exists', function () {",
                  "  pm.expect(orderable, 'no product with minOrderQty <= 20 found').to.not.be.undefined;",
                  "});",
                  "if (orderable) {",
                  "  pm.collectionVariables.set('orderProductId', orderable.id);",
                  "  pm.collectionVariables.set('orderQty', orderable.minOrderQty);",
                  "}"
                ]
              }
            }
          ],
